# Banco PostgreSQL (no Railway, use a variável DATABASE_URL do serviço Postgres)
DATABASE_URL=
# true se o banco exigir SSL (Supabase, Neon). No Railway, deixe em branco.
DATABASE_SSL=
# Senha do painel (/entrar). Use uma senha forte.
ADMIN_PASSWORD=
# Endereço público do site, sem barra no final. Ex.: https://radar.statergroup.com.br
APP_URL=
# (Opcional) WhatsApp da Stater com DDI e DDD, só números. Ex.: 5547999999999
WHATSAPP_NUMBER=
