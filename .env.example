# --- Banco de dados (PostgreSQL 15+ / Supabase) ---
# Conexão da APLICAÇÃO: papel `prolog_app` (sem BYPASSRLS). Todas as consultas passam pela RLS.
DATABASE_URL=postgres://prolog_app:SENHA@HOST:5432/postgres
# Conexão de MIGRAÇÃO/administração (dono do schema). Usada só por scripts, nunca pelo servidor web.
DATABASE_ADMIN_URL=postgres://postgres:SENHA@HOST:5432/postgres
# Conexão direta (modo sessão) para LISTEN/NOTIFY do tempo real. No Supabase, use a porta 5432 (não o pooler 6543).
DATABASE_LISTEN_URL=postgres://prolog_app:SENHA@HOST:5432/postgres
# Senha aplicada ao papel prolog_app por `npm run db:migrate`
APP_DB_PASSWORD=
# true para exigir TLS (Supabase/RDS)
DATABASE_SSL=true

# --- Aplicação ---
APP_URL=https://seu-dominio.com.br
# Sal para pseudonimizar IPs (gere um valor aleatório longo)
IP_HASH_SALT=
# Protege /api/cron/retention (Authorization: Bearer ...)
CRON_SECRET=

# --- Google (opcionais) ---
NEXT_PUBLIC_GTM_ID=          # ex.: GTM-XXXXXXX (recomendado; configure o GA4 dentro do GTM)
NEXT_PUBLIC_GA4_ID=          # ex.: G-XXXXXXXXXX (usado apenas se não houver GTM)

# --- Notificações externas de novo lead (opcionais) ---
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=           # ex.: PROLOG Intelligence <alertas@seu-dominio.com.br>
NOTIFY_WEBHOOK_URL=          # ex.: n8n / Make / integração WhatsApp Business
NOTIFY_WEBHOOK_SECRET=
